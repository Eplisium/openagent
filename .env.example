# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# Optional: App Attribution (for OpenRouter rankings)
SITE_URL=https://localhost
SITE_NAME=OpenRouter Master Script

# Model Selection
# Models are now selected dynamically via the ModelBrowser
# No hardcoded defaults - user picks from OpenRouter API

# Advanced Settings
MAX_RETRIES=3
TIMEOUT_MS=300000
STREAMING_ENABLED=true

# Cost Control
MAX_COST_PER_REQUEST_USD=0.50
BUDGET_WARNING_THRESHOLD=10.00

# Network
# Allow fetch_url to reach localhost/private IPs (for local GitLab, Docker, dev servers)
# Set to 'true' to bypass SSRF protection for local development
# OPENAGENT_ALLOW_LOCAL_NETWORK=true

# Optional: Web Research Enhancement
# Jina Reader API — free tier (~1000 req/day), returns clean markdown from any URL
# Get key: https://jina.ai (optional, works without key for basic usage)
# JINA_API_KEY=

# Firecrawl API — premium web scraping with markdown extraction
# Get key: https://firecrawl.dev (1000 free credits/month)
# FIRECRAWL_API_KEY=

# Search API Keys (all optional — free backends like DuckDuckGo work without keys)
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=