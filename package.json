{
  "name": "openagent",
  "version": "0.1.20",
  "description": "OpenAgent - terminal AI agent with 400+ models via OpenRouter, tool calling, skills and a polished CLI.",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "openagent": "src/cli.js",
    "oagent": "src/cli.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./agent": {
      "import": "./src/agent/Agent.js",
      "default": "./src/agent/Agent.js"
    },
    "./tools": {
      "import": "./src/tools/index.js",
      "default": "./src/tools/index.js"
    },
    "./config": {
      "import": "./src/config.js",
      "default": "./src/config.js"
    },
    "./errors": {
      "import": "./src/errors.js",
      "default": "./src/errors.js"
    }
  },
  "scripts": {
    "start": "node src/cli.js",
    "cli": "node src/cli.js",
    "demo": "node examples/demo.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "streaming": "node examples/streaming-demo.js",
    "tools": "node examples/tool-calling-demo.js",
    "agents": "node examples/agents-demo.js",
    "skills": "node src/cli/skills-commands.js"
  },
  "keywords": [
    "openagent",
    "openrouter",
    "ai",
    "llm",
    "agent",
    "agentic",
    "coding",
    "assistant",
    "cli",
    "cross-platform",
    "skills",
    "plugins"
  ],
  "author": "Zach",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@hono/node-server": "^1.19.17",
    "@inquirer/prompts": "^7.3.3",
    "@mozilla/readability": "^0.6.0",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "cli-spinners": "^3.4.0",
    "cli-table3": "^0.6.5",
    "cross-spawn": "^7.0.3",
    "dotenv": "^16.4.7",
    "figlet": "^1.12.0",
    "glob": "^10.4.5",
    "gradient-string": "^3.0.0",
    "hono": "^4.13.12",
    "inquirer": "^12.3.0",
    "linkedom": "^0.18.14",
    "marked": "^15.0.12",
    "nanospinner": "^1.2.2",
    "pdf-parse": "^2.4.5",
    "picocolors": "^1.1.1",
    "slice-ansi": "^8.0.0",
    "string-width": "^7.2.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^7.30.0",
    "which": "^4.0.0",
    "wrap-ansi": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "eslint": "^9.39.5",
    "strip-ansi": "^7.2.0",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
